rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid && uid == '__AUTHORIZED_UID__'; }
  function allowed(c) { return c in ['workers','allergies','attentions','clinicalItems','lots','movements','mappings','reconciliations','emo','cholinesterase','leaves','alerts','corrections']; }
  function immutable(c) { return c in ['attentions','clinicalItems','movements','corrections']; }
  function receipt(uid) { return getAfter(/databases/$(database)/documents/accounts/$(uid)/operations/$(request.resource.data.operationId)); }
  match /accounts/{uid}/{c}/{id} {
   allow read: if owner(uid) && (allowed(c) || c in ['operations','changes','syncMeta']);
   allow create: if owner(uid) && allowed(c) && request.resource.data.revision == 1
    && request.resource.data.id == id && request.resource.data.collection == c
    && request.resource.data.key == c + ':' + id
    && receipt(uid).data.keys.hasAny([c + ':' + id])
    && receipt(uid).data.sequence == request.resource.data.sequence;
   allow update: if owner(uid) && allowed(c) && !immutable(c)
    && request.resource.data.revision == resource.data.revision + 1
    && request.resource.data.id == id && request.resource.data.collection == c
    && request.resource.data.key == resource.data.key
    && receipt(uid).data.keys.hasAny([c + ':' + id])
    && receipt(uid).data.sequence == request.resource.data.sequence;
  }
  match /accounts/{uid}/operations/{id} {
   allow create: if owner(uid) && request.resource.data.id == id
    && request.resource.data.keys.size() > 0 && request.resource.data.keys.size() <= 180
    && request.resource.data.sequence == getAfter(/databases/$(database)/documents/accounts/$(uid)/syncMeta/clock).data.sequence;
  }
  match /accounts/{uid}/changes/{id} {
   allow create: if owner(uid) && request.resource.data.sequence == getAfter(/databases/$(database)/documents/accounts/$(uid)/syncMeta/clock).data.sequence
    && existsAfter(/databases/$(database)/documents/accounts/$(uid)/operations/$(request.resource.data.operationId));
  }
  match /accounts/{uid}/syncMeta/clock {
   allow create: if owner(uid) && request.resource.data.sequence == 1;
   allow update: if owner(uid) && request.resource.data.sequence == resource.data.sequence + 1;
  }
 }
}
